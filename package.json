{
  "name": "invoice-studio",
  "version": "0.1.0",
  "description": "Native offline-first invoicing and expense desktop app for freelancers",
  "main": "./out/main/index.js",
  "author": "Chris <chris@invoicestudio.local>",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/setup-deps.js",
    "test": "node scripts/run-tests.js run",
    "test:watch": "node scripts/run-tests.js",
    "test:perf": "node scripts/run-tests.js run src/tests/perf/scale-10k.test.ts",
    "test:e2e": "playwright test",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux",
    "verify:assets": "node scripts/verify-release-assets.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.11",
    "better-sqlite3": "^11.1.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.2.1",
    "lucide-react": "^0.408.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.45.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^1.6.0"
  }
}
