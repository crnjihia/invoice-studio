# path: .env.example
# Node environment (development, production, test)
NODE_ENV=development

# Optional custom directory for automated SQLite database backups
# If blank, defaults to appData/InvoiceStudio/backups
APP_BACKUP_PATH=

# Integration providers: "mock" (offline sandbox) or live external services
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock

# Application logging verbosity (debug, info, warn, error)
LOG_LEVEL=info

